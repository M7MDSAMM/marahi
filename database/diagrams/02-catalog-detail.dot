digraph G {
graph [bgcolor="#fffdf8",pad="0.35",nodesep="0.5",ranksep="0.8",splines=spline]; node [fontname="DejaVu Sans",fontsize=11]; edge [fontname="DejaVu Sans",fontsize=9,color="#8c795d",arrowsize=.7];
rankdir=LR;
categories [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="categories\lCategories\l---------------------------\lPK id : int(10)\lUQ code : varchar(40)\l   name_fr : varchar(100)\l   name_ar : varchar(100)\l   image_path : varchar(255)\l   sort_order : smallint(5)\l   is_active : tinyint(1)\l"];
products [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="products\lProduits\l---------------------------\lPK id : int(10)\lFK category_id : int(10)\lUQ slug : varchar(100)\l   name_fr : varchar(100)\l   name_ar : varchar(100)\l   description_fr : text\l   description_ar : text\l   nut_type : ENUM\l   is_visible : tinyint(1)\l   is_featured : tinyint(1)\l   sort_order : smallint(5)\l   created_at : datetime\l   updated_at : datetime\l"];
product_images [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="product_images\lPhotos\l---------------------------\lPK id : int(10)\lFK product_id : int(10)\l   file_path : varchar(255)\l   alt_fr : varchar(150)\l   alt_ar : varchar(150)\l   sort_order : smallint(5)\l"];
product_variants [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="product_variants\lVarietes / moutures\l---------------------------\lPK id : int(10)\lFK product_id : int(10)\l   code : varchar(60)\l   name_fr : varchar(100)\l   name_ar : varchar(100)\l   is_active : tinyint(1)\l   sort_order : smallint(5)\l"];
product_options [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="product_options\lOffres vendables (SKU)\l---------------------------\lPK id : int(10)\lFK variant_id : int(10)\lUQ sku : varchar(60)\l   weight_g : int(10)\l   price : decimal(12,3)\l   is_available : tinyint(1)\l   sort_order : smallint(5)\l   updated_at : datetime\l"];
categories -> products [label="category_id",taillabel="1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
products -> product_images [label="product_id",taillabel="1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
product_variants -> product_options [label="variant_id",taillabel="1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
products -> product_variants [label="product_id",taillabel="1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
}