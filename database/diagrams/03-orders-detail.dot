digraph G {
graph [bgcolor="#fffdf8",pad="0.35",nodesep="0.5",ranksep="0.8",splines=spline]; node [fontname="DejaVu Sans",fontsize=11]; edge [fontname="DejaVu Sans",fontsize=9,color="#8c795d",arrowsize=.7];
rankdir=LR;
users [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="users\lComptes\l---------------------------\lPK id : int(10)\l   full_name : varchar(100)\lUQ email : varchar(190)\l   phone : varchar(16)\l   password_hash : varchar(255)\l   role : ENUM\l   is_active : tinyint(1)\l   preferred_language : ENUM\l   created_at : datetime\l   updated_at : datetime\l"];
orders [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="orders\lCommandes\l---------------------------\lPK id : int(10)\lUQ reference : varchar(32)\lUQ request_key : char(36)\lFK user_id : int(10)\l   customer_name : varchar(100)\l   customer_phone : varchar(16)\l   customer_email : varchar(190)\l   language : ENUM\l   reception_mode : ENUM\l   delivery_address : varchar(300)\l   delivery_city : varchar(100)\l   delivery_postal_code : char(4)\l   customer_note : varchar(1000)\l   subtotal : decimal(12,3)\l   delivery_fee : decimal(12,3)\l   total : decimal(12,3)\l   currency : char(3)\l   status : ENUM\l   payment_method : ENUM\l   payment_status : ENUM\l   paid_at : datetime\l   created_at : datetime\l   updated_at : datetime\l"];
order_items [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="order_items\lLignes de commande\l---------------------------\lPK id : int(10)\lFK order_id : int(10)\lFK option_id : int(10)\l   product_name_fr : varchar(100)\l   product_name_ar : varchar(100)\l   variant_name_fr : varchar(100)\l   variant_name_ar : varchar(100)\l   weight_g : int(10)\l   quantity : smallint(5)\l   unit_price : decimal(12,3)\l   line_total : decimal(12,3)\l"];
product_options [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="product_options\lOffres vendables (SKU)\l---------------------------\lPK id : int(10)\lFK variant_id : int(10)\lUQ sku : varchar(60)\l   weight_g : int(10)\l   price : decimal(12,3)\l   is_available : tinyint(1)\l   sort_order : smallint(5)\l   updated_at : datetime\l"];
order_status_history [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="order_status_history\lHistorique\l---------------------------\lPK id : int(10)\lFK order_id : int(10)\l   from_status : ENUM\l   to_status : ENUM\l   actor_type : ENUM\lFK actor_user_id : int(10)\l   note : varchar(500)\l   created_at : datetime\l"];
users -> orders [label="user_id",taillabel="0..1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
product_options -> order_items [label="option_id",taillabel="1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
orders -> order_items [label="order_id",taillabel="1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
users -> order_status_history [label="actor_user_id",taillabel="0..1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#b9b0a3",style="dashed"];
orders -> order_status_history [label="order_id",taillabel="1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
}