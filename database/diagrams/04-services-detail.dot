digraph G {
graph [bgcolor="#fffdf8",pad="0.35",nodesep="0.5",ranksep="0.8",splines=spline]; node [fontname="DejaVu Sans",fontsize=11]; edge [fontname="DejaVu Sans",fontsize=9,color="#8c795d",arrowsize=.7];
rankdir=TB;
users [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="users\lComptes\l---------------------------\lPK id : int(10)\l   full_name : varchar(100)\lUQ email : varchar(190)\l   phone : varchar(16)\l   password_hash : varchar(255)\l   role : ENUM\l   is_active : tinyint(1)\l   preferred_language : ENUM\l   created_at : datetime\l   updated_at : datetime\l"];
user_addresses [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="user_addresses\lAdresse sauvegardee\l---------------------------\lPK id : int(10)\lFK user_id : int(10)\l   address_line : varchar(300)\l   city : varchar(100)\l   postal_code : char(4)\l   updated_at : datetime\l"];
password_reset_tokens [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="password_reset_tokens\lReinitialisation\l---------------------------\lPK id : int(10)\lFK user_id : int(10)\lUQ token_hash : char(64)\l   expires_at : datetime\l   used_at : datetime\l   created_at : datetime\l"];
products [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="products\lProduits\l---------------------------\lPK id : int(10)\lFK category_id : int(10)\lUQ slug : varchar(100)\l   name_fr : varchar(100)\l   name_ar : varchar(100)\l   description_fr : text\l   description_ar : text\l   nut_type : ENUM\l   is_visible : tinyint(1)\l   is_featured : tinyint(1)\l   sort_order : smallint(5)\l   created_at : datetime\l   updated_at : datetime\l"];
milling_appointments [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="milling_appointments\lDemandes de mouture\l---------------------------\lPK id : int(10)\lUQ reference : varchar(32)\lFK user_id : int(10)\lFK grain_product_id : int(10)\l   customer_name : varchar(100)\l   customer_phone : varchar(16)\l   grain_name : varchar(120)\l   quantity_kg : decimal(8,3)\l   grind_level : ENUM\l   requested_date : date\l   confirmed_date : date\l   status : ENUM\l   customer_note : varchar(1000)\l   status_reason : varchar(500)\lFK handled_by_user_id : int(10)\l   completed_at : datetime\l   created_at : datetime\l   updated_at : datetime\l"];
contact_messages [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="contact_messages\lMessages\l---------------------------\lPK id : int(10)\lFK user_id : int(10)\l   sender_name : varchar(100)\l   sender_phone : varchar(16)\l   message_text : text\l   status : ENUM\lFK handled_by_user_id : int(10)\l   resolved_at : datetime\l   created_at : datetime\l"];
users -> contact_messages [label="user_id",taillabel="0..1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
users -> contact_messages [label="handled_by_user_id",taillabel="0..1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#b9b0a3",style="dashed"];
users -> milling_appointments [label="user_id",taillabel="0..1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
users -> milling_appointments [label="handled_by_user_id",taillabel="0..1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#b9b0a3",style="dashed"];
products -> milling_appointments [label="grain_product_id",taillabel="0..1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
users -> password_reset_tokens [label="user_id",taillabel="1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
users -> user_addresses [label="user_id",taillabel="1",headlabel="0..1",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
}