digraph G {graph [bgcolor="#fffdf8",pad="0.35",nodesep="0.5",ranksep="0.8",splines=spline]; node [fontname="DejaVu Sans",fontsize=11]; edge [fontname="DejaVu Sans",fontsize=9,color="#8c795d",arrowsize=.7];rankdir=LR; node [shape=box,style="rounded,filled",fillcolor="#f5eddf",margin=".2,.15"];
pending [label="pending\nDemande recue"];
confirmed [label="confirmed\nJour confirme"];
rejected [label="rejected\nRefusee avec motif",fillcolor="#f4e2dc",peripheries=2];
done [label="done\nPrestation terminee",fillcolor="#e0eee3",peripheries=2];
cancelled [label="cancelled\nAnnulee avec motif",fillcolor="#f4e2dc",peripheries=2];
pending -> confirmed [label="accord + confirmed_date"];
pending -> rejected [label="indisponibilite"];
pending -> cancelled [label="retrait de la demande"];
confirmed -> done [label="mouture effectuee"];
confirmed -> cancelled [label="annulation avant service"];
}