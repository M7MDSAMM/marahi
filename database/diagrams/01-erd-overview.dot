digraph G {
graph [bgcolor="#fffdf8",pad="0.35",nodesep="0.5",ranksep="0.8",splines=spline]; node [fontname="DejaVu Sans",fontsize=11]; edge [fontname="DejaVu Sans",fontsize=9,color="#8c795d",arrowsize=.7];
rankdir=TB;
categories [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="categories\lCategories\l---------------------------\lPK id : int(10)\lUQ code : varchar(40)\l   name_fr : varchar(100)\l   name_ar : varchar(100)\l"];
contact_messages [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="contact_messages\lMessages\l---------------------------\lPK id : int(10)\lFK user_id : int(10)\l   status : ENUM\lFK handled_by_user_id : int(10)\l"];
milling_appointments [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="milling_appointments\lDemandes de mouture\l---------------------------\lPK id : int(10)\lFK user_id : int(10)\lFK grain_product_id : int(10)\l   requested_date : date\l   status : ENUM\lFK handled_by_user_id : int(10)\l"];
orders [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="orders\lCommandes\l---------------------------\lPK id : int(10)\lUQ reference : varchar(32)\lUQ request_key : char(36)\lFK user_id : int(10)\l   reception_mode : ENUM\l   total : decimal(12,3)\l   status : ENUM\l"];
order_items [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="order_items\lLignes de commande\l---------------------------\lPK id : int(10)\lFK order_id : int(10)\lFK option_id : int(10)\l   quantity : smallint(5)\l   unit_price : decimal(12,3)\l   line_total : decimal(12,3)\l"];
order_status_history [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="order_status_history\lHistorique\l---------------------------\lPK id : int(10)\lFK order_id : int(10)\l   from_status : ENUM\l   to_status : ENUM\lFK actor_user_id : int(10)\l"];
password_reset_tokens [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="password_reset_tokens\lReinitialisation\l---------------------------\lPK id : int(10)\lFK user_id : int(10)\lUQ token_hash : char(64)\l   expires_at : datetime\l   used_at : datetime\l"];
products [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="products\lProduits\l---------------------------\lPK id : int(10)\lFK category_id : int(10)\lUQ slug : varchar(100)\l   name_fr : varchar(100)\l   name_ar : varchar(100)\l   is_visible : tinyint(1)\l"];
product_images [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="product_images\lPhotos\l---------------------------\lPK id : int(10)\lFK product_id : int(10)\l   file_path : varchar(255)\l"];
product_options [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="product_options\lOffres vendables (SKU)\l---------------------------\lPK id : int(10)\lFK variant_id : int(10)\lUQ sku : varchar(60)\l   weight_g : int(10)\l   price : decimal(12,3)\l   is_available : tinyint(1)\l"];
product_variants [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="product_variants\lVarietes / moutures\l---------------------------\lPK id : int(10)\lFK product_id : int(10)\l   code : varchar(60)\l   name_fr : varchar(100)\l   name_ar : varchar(100)\l"];
users [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="users\lComptes\l---------------------------\lPK id : int(10)\lUQ email : varchar(190)\l   role : ENUM\l   is_active : tinyint(1)\l"];
user_addresses [shape=box,style="rounded,filled",fillcolor="#fffdf8",color="#b6a07b",margin=".18,.14",fontname="Courier",label="user_addresses\lAdresse sauvegardee\l---------------------------\lPK id : int(10)\lFK user_id : int(10)\l   address_line : varchar(300)\l   city : varchar(100)\l"];
users -> contact_messages [label="user_id",taillabel="0..1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
users -> contact_messages [label="handled_by_user_id",taillabel="0..1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#b9b0a3",style="dashed"];
users -> milling_appointments [label="user_id",taillabel="0..1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
users -> milling_appointments [label="handled_by_user_id",taillabel="0..1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#b9b0a3",style="dashed"];
products -> milling_appointments [label="grain_product_id",taillabel="0..1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
users -> orders [label="user_id",taillabel="0..1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
product_options -> order_items [label="option_id",taillabel="1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
orders -> order_items [label="order_id",taillabel="1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
users -> order_status_history [label="actor_user_id",taillabel="0..1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#b9b0a3",style="dashed"];
orders -> order_status_history [label="order_id",taillabel="1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
users -> password_reset_tokens [label="user_id",taillabel="1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
categories -> products [label="category_id",taillabel="1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
products -> product_images [label="product_id",taillabel="1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
product_variants -> product_options [label="variant_id",taillabel="1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
products -> product_variants [label="product_id",taillabel="1",headlabel="0..N",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
users -> user_addresses [label="user_id",taillabel="1",headlabel="0..1",dir=both,arrowtail=none,arrowhead=none,labeldistance=2.0,color="#92702e",style="solid"];
}